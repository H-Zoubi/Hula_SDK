# Virtual environment
venv/

# Python-generated files
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
.pytest_cache/

# Vendor installers, wheels, and extracted archives (hundreds of MB).
# Kept locally as offline install sources -- not part of the package.
vendor/

# Runtime artifact from pyhula's video/RTP pipeline (see README's
# "Tested vs untested" -- its connection line is malformed, which is why
# the video decoder never gets a valid frame).
tmp.sdp

# Output of running examples/working_video_stream.py -- a real captured
# photo, not project source.
photo.jpg

# OS / office-suite clutter
desktop.ini
.~lock.*#
